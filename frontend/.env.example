VITE_APP_NAME=หมากระทุปุ๊ป๊ะ

# Supabase — หาได้ที่ Dashboard > Project Settings > API Keys
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Base URL ของ API ตัวเอง (เว้นว่างไว้เพื่อใช้ dev proxy ที่ /api)
VITE_API_BASE_URL=/api

# ปลายทางที่ dev server จะ proxy /api ไปให้
VITE_PROXY_TARGET=http://localhost:8000
