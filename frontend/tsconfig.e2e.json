{
  "compilerOptions": {
    "target": "ES2023",
    // เทสต์รันบน Node แต่ page.evaluate() เขียนโค้ดที่รันในเบราว์เซอร์ จึงต้องมี DOM ด้วย
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "composite": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"]
  },
  "include": ["e2e", "playwright.config.ts"]
}
